@page "/events"
@using EventEase.Models
@rendermode InteractiveServer

<PageTitle>Events | EventEase</PageTitle>

<section class="page-intro">
    <p class="eyebrow">The EventEase calendar</p>
    <h1>Make room for<br /><em>something memorable.</em></h1>
    <p class="intro-copy">Gatherings for curious people, generous teams, and the ideas that bring us together.</p>
</section>

<section class="events-section" aria-labelledby="upcoming-events">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Curated for you</p>
            <h2 id="upcoming-events">Upcoming events</h2>
        </div>
        <span class="event-count">@EventCatalog.All.Count events</span>
    </div>
    <div class="event-grid">
        <Virtualize Items="@EventCatalog.All" Context="eventItem">
            <EventCard @key="eventItem.Id" Event="eventItem" />
        </Virtualize>
    </div>
</section>
